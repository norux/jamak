{
  "name": "jamak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "release:chrome": "node scripts/release-chrome.mjs",
    "test:release:chrome": "node --test tests/chrome-release.test.mjs",
    "build:chrome": "vite build --config vite.chrome.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:framework": "tsc -p tsconfig.contracts.json && tsc -p tsconfig.framework.json",
    "test:js": "node --import tsx --test tests/*.test.ts tests/framework-video-fixture.test.mjs tests/chrome-release.test.mjs",
    "test:speakers": "node tests/speaker-conversation-browser.mjs",
    "test:auto-language:live": "node tests/framework-chrome-tab-engine.mjs --auto-language",
    "test:conversation:live": "node tests/framework-chrome-tab-engine.mjs --conversation",
    "test:conversation:ja:live": "node tests/framework-chrome-tab-engine.mjs --japanese-conversation",
    "test:captions-stability": "node tests/captions-stability-browser.mjs",
    "test:conversation": "python3 -m http.server 8790 --bind 127.0.0.1 --directory tests/fixtures/conversation",
    "dev": "node scripts/dev-chrome.mjs",
    "build": "vite build --config vite.chrome.config.ts",
    "lint": "biome lint apps/chrome packages tests scripts vite.config.ts vite.chrome.config.ts",
    "test": "npm run test:js && npm run test:captions-stability",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:framework && npm run build && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/chrome": "0.3.4",
    "@types/node": "26.6.4",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@paddleocr/paddleocr-js": "0.4.2"
  },
  "license": "MIT"
}
